<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Universal Structured Data plugin for Renderer -->
    <type name="Magento\Framework\View\Page\Config\Renderer">
        <plugin name="defox_seosuite_universal_structured_data" type="Defox\SEOSuite\Plugin\Framework\View\Page\Config\UniversalStructuredDataPlugin" sortOrder="10" />
        <plugin name="defox_seosuite_noindex_handler" type="Defox\SEOSuite\Plugin\Head\NoindexHandler" sortOrder="200" />
    </type>
    
    <!-- Friendly filter URLs: outbound layered-nav links -->
    <type name="Magento\Catalog\Model\Layer\Filter\Item">
        <plugin name="defox_seosuite_filter_url_rewrite" type="Defox\SEOSuite\Plugin\Catalog\Layer\FilterItemUrl" sortOrder="10" />
    </type>
    <type name="Magento\Swatches\Block\LayeredNavigation\RenderLayered">
        <plugin name="defox_seosuite_filter_url_rewrite" type="Defox\SEOSuite\Plugin\Catalog\Layer\SwatchFilterUrl" sortOrder="10" />
    </type>

    <!-- Friendly filter URLs: inbound router, before core urlrewrite (sortOrder 20) -->
    <type name="Magento\Framework\App\RouterList">
        <arguments>
            <argument name="routerList" xsi:type="array">
                <item name="defox_seosuite_filter" xsi:type="array">
                    <item name="class" xsi:type="string">Defox\SEOSuite\Controller\Router\FilterRouter</item>
                    <item name="disable" xsi:type="boolean">false</item>
                    <item name="sortOrder" xsi:type="string">15</item>
                </item>
            </argument>
        </arguments>
    </type>

    <!-- Meta templates: tag cacheable entity pages so a template save/delete purges them (CR-32).
         Name keeps core's leading backslash (module-catalog etc/frontend/di.xml) so the XML nodes merge
         instead of one "preprocessors" argument replacing the other. -->
    <type name="\Magento\PageCache\Model\PageCacheTagsPreprocessorComposite">
        <arguments>
            <argument name="preprocessors" xsi:type="array">
                <item name="catalog_product_view" xsi:type="array">
                    <item name="defox_seosuite_meta_template" xsi:type="object">Defox\SEOSuite\Model\MetaTag\PageCacheTags</item>
                </item>
                <item name="catalog_category_view" xsi:type="array">
                    <item name="defox_seosuite_meta_template" xsi:type="object">Defox\SEOSuite\Model\MetaTag\PageCacheTags</item>
                </item>
                <item name="cms_page_view" xsi:type="array">
                    <item name="defox_seosuite_meta_template" xsi:type="object">Defox\SEOSuite\Model\MetaTag\PageCacheTags</item>
                </item>
                <item name="cms_index_index" xsi:type="array">
                    <item name="defox_seosuite_meta_template" xsi:type="object">Defox\SEOSuite\Model\MetaTag\PageCacheTags</item>
                </item>
            </argument>
        </arguments>
    </type>
</config>