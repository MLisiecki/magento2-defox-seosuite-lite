{
    "name": "defox/seosuite-lite",
    "description": "A comprehensive SEO Lite solution for Magento 2.4.7–2.4.9",
    "type": "magento2-module",
    "version": "2.0.0",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Marcin Lisiecki",
            "email": "marcin@defox.pl"
        }
    ],
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "ext-zlib": "*",
        "magento/framework": ">=103.0.7 <103.1",
        "magento/module-backend": "102.0.*",
        "magento/module-catalog": "104.0.*",
        "magento/module-catalog-inventory": "100.4.*",
        "magento/module-cms": "104.0.*",
        "magento/module-csp": "100.4.*",
        "magento/module-config": "101.2.*",
        "magento/module-cron": "100.4.*",
        "magento/module-eav": "102.1.*",
        "magento/module-email": "101.1.*",
        "magento/module-layered-navigation": "100.4.*",
        "magento/module-media-storage": "100.4.*",
        "magento/module-page-cache": "100.4.*",
        "magento/module-sitemap": "100.4.*",
        "magento/module-store": "101.1.*",
        "magento/module-ui": "101.2.*",
        "magento/module-url-rewrite": "102.0.*"
    },
    "suggest": {
        "magento/module-review": "Enables aggregateRating/review output in Product structured data",
        "magento/module-swatches": "Friendly filter URLs for swatch layered-navigation links"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Defox\\SEOSuite\\": ""
        }
    }
}
